project.manifest = manifest.xml
project.optimization = 3z

base.sourcePath = source

# Full tier keeps standard code paths and excludes lite-only alternates.
base.excludeAnnotations = test;testsupport;lite;instinct

# Lite devices exclude all full-tier implementations.
instinct2.excludeAnnotations = full;test;testsupport
instinct2s.excludeAnnotations = full;test;testsupport
instinct3solar45mm.excludeAnnotations = full;test;testsupport
fenix5.excludeAnnotations = full;test;testsupport
fenix5s.excludeAnnotations = full;test;testsupport
fenix5x.excludeAnnotations = full;test;testsupport
fenix6.excludeAnnotations = full;test;testsupport
fenix6s.excludeAnnotations = full;test;testsupport
